# Required: the key Raken uses for its AI models (console.anthropic.com).
ANTHROPIC_API_KEY=

# The public address of your Raken server, e.g. https://raken.example.com
PUBLIC_URL=

# Payments (Stripe). Create two monthly prices: $3 (Lite) and $30 (Plus).
# Point a webhook at https://<your domain>/api/billing/webhook with the events
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted and invoice.paid.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LITE=
STRIPE_PRICE_PLUS=

# Where accounts and conversations are stored (defaults to ./data).
RAKEN_DATA_DIR=
