{
  "name": "raken-desktop",
  "productName": "Raken",
  "version": "2.0.0",
  "description": "Raken for Windows and Mac",
  "author": "Raken",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "npm run bundle && electron .",
    "dist:mac": "npm run bundle && electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:win": "npm run bundle && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "ai.raken.desktop",
    "productName": "Raken",
    "copyright": "© Raken",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "config.json",
      "app/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Raken ${version}",
      "artifactName": "Raken-${version}-${arch}.dmg"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Raken-Setup-${version}.exe",
      "shortcutName": "Raken"
    }
  }
}
