{
  "manifest_version": 3,
  "name": "Premium+ for YouTube",
  "short_name": "Premium+",
  "version": "1.0.0",
  "description": "A just-for-fun 'Premium' for YouTube: Premium logo, ad skipping, speeds up to 16x, GIFs in comments and more.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Premium+",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://sponsor.ajay.app/*", "https://api.giphy.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_start",
      "all_frames": true,
      "css": ["content/styles.css"],
      "js": [
        "defaults.js",
        "content/gif-core.js",
        "content/shared.js",
        "content/look.js",
        "content/ads.js",
        "content/speed.js",
        "content/buttons.js",
        "content/volume.js",
        "content/sponsorblock.js",
        "content/gifs.js"
      ]
    }
  ]
}
